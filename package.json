{
  "name": "niconamasidebar",
  "version": "1.20.3",
  "description": "ニコ生の番組視聴ページにサイドバーを設置します。",
  "author": "MynicoTools",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.kickpage.config.js",
    "postbuild": "node scripts/remove-maps.js",
    "preview": "vite preview",
    "verify:loop": "node scripts/verify-sidebar-loop.mjs",
    "clean": "rimraf dist",
    "clean:maps": "node scripts/remove-maps.js",
    "watch": "vite build --watch",
    "verify:e2e": "node scripts/verify-e2e.mjs"
  },
  "devDependencies": {
    "glob": "^11.0.3",
    "rimraf": "^5.0.0",
    "vite": "^5.0.0",
    "playwright-core": "^1.49.0"
  }
}
